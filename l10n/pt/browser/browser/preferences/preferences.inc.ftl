pane-librewolf-title2 = LibreWolf
    .title = LibreWolf
category-librewolf =
    .tooltiptext = As alterações do about:config, logicamente agrupadas e facilmente acessíveis
librewolf-header = Preferências do LibreWolf
librewolf-warning-title = Atenção!
librewolf-warning-description = Escolhemos cuidadosamente as configurações padrão para focar na privacidade e segurança. Ao alterar estas configurações, leia as descrições para entender as implicações dessas mudanças.
librewolf-general-heading2 =
    .label = Comportamento do navegador
librewolf-extension-update-checkbox2 =
    .label = Atualizar extensões automaticamente
    .description = Mantenha as extensões atualizadas sem intervenção manual. Uma boa escolha para a sua segurança.
librewolf-sync-checkbox2 =
    .label = Permitir sincronização do Firefox
    .description = Sincronizar os seus dados com outros navegadores. Requer reinicialização.
librewolf-autocopy-checkbox2 =
    .label = Ativar colar com o botão do meio
    .description = Selecione um texto para copiá-lo e, em seguida, cole-o com um clique do botão do meio do rato.
librewolf-styling-checkbox2 =
    .label = Permitir customização userChrome.css
    .description = Ative isto se você quer customizar a interface visual com temas carregados manualmente.
librewolf-nova-checkbox2 =
    .label = Ativar o redesign Nova
librewolf-network-heading2 =
    .label = Rede
librewolf-ipv6-checkbox2 =
    .label = Ativar IPv6
    .description = Permitir que o { -brand-short-name } se conecte usando IPv6.
librewolf-privacy-heading2 =
    .label = Privacidade
librewolf-xorigin-ref-checkbox2 =
    .label = Limitar referenciadores entre origens diferentes
    .description = Enviar um referenciador apenas na mesma origem.
librewolf-broken-heading2 =
    .label = Impressão digital
librewolf-jit-checkbox2 =
    .label = Desativar JavaScript JIT por padrão
    .description = Isso desativa a compilação em tempo real JavaScript por padrão para reduzir a superfície de ataque, mas permitindo escolher para cada site.
librewolf-webgl-checkbox2 =
    .label = Sempre permitir WebGL
    .description = Isso sempre permitirá o WebGL sem solicitação de permissão.
librewolf-webgl-prompt-checkbox2 =
    .label = Esconder o pop-up do WebGL por site
    .description = Isso esconde o pop-up que aparece quando um site tenta criar um contexto WebGL. Você ainda pode exibir manualmente o prompt clicando no ícone na barra de pesquisa.
librewolf-rfp-checkbox2 =
    .label = Ativar ResistFingerprinting
    .description = Ativa todas as mitigações de impressão digital disponíveis, mas pode fazer com que alguns sites funcionem incorretamente.
librewolf-letterboxing-checkbox2 =
    .label = Ativar letterboxing
    .description = O letterboxing aplica margens ao redor das suas janelas, a fim de retornar um conjunto limitado de resoluções arredondadas.
librewolf-security-heading2 =
    .label = Segurança
librewolf-ocsp-checkbox =
    .label = Impor OCSP de falha rígida
librewolf-goog-safe-checkbox =
    .label = Ativar Navegação Segura do Google
librewolf-goog-safe-download-checkbox =
    .label = Verificar Downloads
librewolf-ocsp-description = Impedir conexão a um site se a verificação OCSP falhar.
librewolf-ocsp-warning1 = Isso reforça a segurança, mas causará falhas quando um servidor OCSP estiver indisponível.
librewolf-goog-safe-description = Se você estiver preocupado com malware e phishing, considere ativá-lo.
librewolf-goog-safe-warning1 = Desativado por motivos de censura, mas recomendado para utilizador menos experientes. Todas as verificações são feitas localmente.
librewolf-goog-safe-download-description = Permitir que a Navegação Segura verifique os seus downloads para identificar arquivos suspeitos.
librewolf-goog-safe-download-warning1 = Todas as verificações são feitas localmente.
librewolf-footer = Links Úteis
librewolf-config-link = Todas as configurações avançadas (about:config)
librewolf-open-profile = Abrir pasta do perfil do utilizador
content-blocking-section-top-level-description = O LibreWolf suporta - e ativa por padrão - a Proteção Aprimorada Contra Rastreamento no modo Estrito. Esta é uma das opções mais importantes do navegador, pois oferece particionamento de estado, listas de bloqueio restritas e outras funcionalidades de privacidade úteis. Não recomendamos alterar para outros modos.
librewolf-etp =
    .label = Proteção Aprimorada contra Rastreamento
    .description = O LibreWolf suporta - e ativa por padrão - a Proteção Aprimorada contra Rastreamento no modo Rigoroso. Esta é uma das configurações mais importantes do navegador, já que ela oferece partição de estados, listas de bloqueio rígidas e outros recursos interessantes de privacidade. Não é recomendado alterar para outros modos.
librewolf-swap-settings = Trocar modelo de configurações
    .title = Trocar modelo de configurações
librewolf-mouse-heading2 =
    .label = Comportamento do rato
librewolf-h264 =
    .label = Ativar o plugin OpenH264
    .description = Necessário para compartilhar o ecrã em alguns sites como o Discord.
permissions-eme2 =
    .label = Conteúdo controlado por direitos autorais
permissions-webgl2 =
    .label = WebGL
permissions-canvas2 =
    .label = Extração de dados do ecrã
permissions-jit2 =
    .label = JavaScript JIT
librewolf-rfp-warning =
    .message = Esta funcionalidade está desativada porque a opção ResistFingerprinting está ativada. Isso significa que o LibreWolf forçará o conteúdo web a ser exibido no tema claro.
librewolf-is-default-browser-2 =
    .message = { -brand-short-name } foi configurado como o seu navegador padrão.
librewolf-is-not-default-browser-2 =
    .message = { -brand-short-name } não é o seu navegador padrão.
update-application-disabled-choose-2 =
    .label = Desativar o atualizador
    .accesskey = D
update-application-updates-disabled =
    .message = O atualizador integrado foi desativado. As atualizações devem ser geridas manualmente ou por meio de um serviço externo.
