permissions-site-eme-window2 =
    .title = Configurações - Permissões EME
    .style = { permissions-window2.style }
permissions-site-eme-desc = Os seguintes sites pediram para reproduzir conteúdo protegido por DRM. Você pode especificar quais sites estão autorizados para reproduzir conteúdo protegido por DRM. Você também pode bloquear novos pedidos para reproduzir conteúdo protegido por DRM.
permissions-site-eme-disable-label =
    .label = Bloquear novos pedidos para reproduzir conteúdo controlado por DRM
permissions-site-eme-disable-desc = Isto vai prevenir quaisquer sites não listados acima de requisitar permissão para reproduzir conteúdos protegidos por DRM.
permissions-site-webgl-window2 =
    .title = Configurações - Permissões WebGL
    .style = { permissions-window2.style }
permissions-site-webgl-desc = Os seguintes sites solicitaram a criação de um contexto WebGL. Você pode especificar quais sites têm permissão para criar um contexto WebGL. Também pode bloquear novos pedidos que peçam a criação de um contexto WebGL.
permissions-site-canvas-window2 =
    .title = Configurações - Permissão para extrair imagens
    .style = { permissions-window2.style }
permissions-site-canvas-desc = Os seguintes sites pediram permissão para extrair dados do canvas. Você pode especificar quais sites têm permissão para extrair dados do canvas. Você também pode bloquear novos pedidos para extrair dados do canvas.
permissions-site-jit-window2 =
    .title = Configurações - Permissões JavaScript JIT
    .style = { permissions-window2.style }
permissions-site-jit-desc = Os seguintes sites têm permissão para executar JavaScript JIT. Desativá-lo pode melhorar a segurança por reduzir a exposição a ataques de código malicioso, mas pode deixar sites e aplicações mais lentas. WebAssembly não funcionará com JIT desativado.
