From 685e82ac82921720c6cd9c6c45703ff034f081e7 Mon Sep 17 00:00:00 2001
From: Thomas Deutschmann <whissi@gentoo.org>
Date: Sat, 29 Aug 2020 22:30:59 +0200
Subject: [PATCH 25/30] LTO: Only enable LTO for Rust when complete build uses
 LTO

Signed-off-by: Thomas Deutschmann <whissi@gentoo.org>
---
 build/moz.configure/rust.configure | 1 +
 1 file changed, 1 insertion(+)

diff --git a/build/moz.configure/rust.configure b/build/moz.configure/rust.configure
index a50522105f..647b219d3e 100644
--- a/build/moz.configure/rust.configure
+++ b/build/moz.configure/rust.configure
@@ -1012,6 +1012,7 @@ set_config("RUST_PGO_LDFLAGS", rust_pgo_ldflags)
 rust_lto_eligible = (
     ~developer_options
     & ~debug_rust
+    & lto.enabled
     & ~lto.rust_lto
     & ~rust_sancov_flags
     & ~code_coverage
