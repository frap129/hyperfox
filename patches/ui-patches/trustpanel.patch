   padding-block-end: var(--space-small);
 }
 
+/* Trustpanel improvements */
+.trustpanel-card-main,
+#trustpanel-etp-description {
+  display: none !important;
+}
+
+.trustpanel-card-content,
+#trustpanel-popup-host-wrapper {
+  gap: var(--space-xsmall);
+}
+
+#trustpanel-etp-label,
+#trustpanel-graphic-section,
+#trustpanel-blocker-section,
+#trustpanel-insecure-section {
+  border: 0 !important;
+  padding: 0 !important;
+  margin: 0 !important;
+  background: 0 !important;
+}
+
+#trustpanel-graphic-section {
+  margin-inline: var(--panel-menuitem-margin-inline) !important;
+  padding-inline: var(--panel-menuitem-padding-inline) !important;
+}
+
+#trustpanel-header-row {
+  order: -2;
+}
+
+#trustpanel-toggle-section {
+  order: -1;
+  margin-block: var(--space-medium) var(--space-large) !important;
+}
+
+#trustpanel-blocker-section,
+#trustpanel-insecure-section {
+  margin-bottom: var(--space-medium) !important;
+}
+
+/* Tracker count improvements */
+#trustpanel-blocker-section {
+  flex-direction: row;
+  align-items: center;
+  justify-content: space-between;
+  > label:nth-child(1) {
+    font-weight: normal;
+  }
+  > label:nth-child(2) {
+    display: none;
+  }
+}
+
+#trustpanel-blocker-see-all::part(button) {
+  min-height: auto;
+  padding: 0 !important;
+  background: 0;
+  color: var(--link-color);
+  font-weight: normal;
+  text-decoration: underline;
+}
+
+/* Fix "Connection protections" menu spacing */
+#identity-popup-content-cert-info {
+  border: 0 !important;
+}
+
+#trustpanel-popup-security-httpsonlymode {
+  margin-bottom: var(--space-medium);
+  > label {
+    margin-bottom: var(--space-xsmall);
+  }
+}
+
+/* Fix "Clear cookies and site data" menu spacing */
+label[data-l10n-id="trustpanel-clear-cookies-description"] {
+  margin-bottom: var(--space-medium);
+}
+
+/* Fix "Fingerprinters Blocked" menu spacing */
+#trustpanel-blocked + toolbarseparator {
+  display: none !important;
+}
+
+#trustpanel-blocked-header,
+#trustpanel-blocker-details-header,
+#trustpanel-blocker-details-content,
+#trustpanel-blocker-details-list-header {
+  margin-block: var(--space-medium) 0 !important;
+  margin-inline: var(--panel-menuitem-margin-inline);
+  padding-inline: var(--panel-menuitem-padding-inline);
+}
+
+#trustpanel-blocked-header {
+  margin-block: var(--space-medium) var(--space-xsmall) !important;
+}
+
+#trustpanel-blocker-details-content {
+  margin-bottom: var(--space-medium) !important;
+}
+
+#trustpanel-blocker-items {
+  padding-bottom: var(--space-medium) !important;
+}
+
 #trustpanel-header-row {
