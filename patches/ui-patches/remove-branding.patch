+/* Remove Firefox's kit from 'History' and 'Tabs from other devices' */
+fxview-empty-state {
+  &::part(container) {
+    justify-content: center;
+  }
+  &::part(image-container) {
+    display: none;
+  }
+}
+
+/* Remove Firefox's kit from 'Passwords' */
+.no-logins-card-content {
+  img {
+    display: none;
+  }
+  p[data-l10n-id="contextual-manager-passwords-no-passwords-get-started-message"] {
+    margin-top: 0;
+  }
+}
+
 body {
   margin: 0;
   height: 100%;
