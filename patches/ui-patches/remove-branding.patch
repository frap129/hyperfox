+}
+
 #unified-extensions-panel {
   --uei-dot-horizontal-position-in-panel: calc(var(--uei-icon-size) / 2 + var(--panel-menuitem-padding-inline) - var(--uei-attention-dot-size) / 2);
   --uei-dot-vertical-position-in-panel: max(0px, calc(var(--panel-menuitem-padding-block) / 2 - var(--uei-attention-dot-size) / 2));
